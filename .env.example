# Contoh konfigurasi environment — JANGAN isi nilai asli di sini.
# File .env yang sebenarnya disuplai otomatis oleh Lovable Cloud dan tidak boleh di-commit.
#
# Untuk pengembangan lokal: salin file ini menjadi .env lalu isi dari
# Lovable → Cloud → Settings (URL & anon key) dan Cloud → Secrets (service role, dll).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk script lokal / edge functions (jangan commit nilai aslinya)
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
ADMIN_BOOTSTRAP_SECRET=
